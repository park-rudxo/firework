// SSAFY 프로젝트 공유 플랫폼 — 데이터 모델
//
// 이 스키마에서 가장 중요한 결정 하나: SurveyResponse 에는 userId 가 없다.
// 익명 설문과 응답자 추첨을 동시에 만족시키기 위해 "무엇을 썼나"(SurveyResponse)와
// "누가 썼나"(SurveyParticipation)를 서로 참조하지 않는 두 테이블로 쪼갰다.
// 자세한 근거는 SurveyResponse 모델 위 주석 참고.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Better Auth 관리 테이블 (@better-auth/cli generate 산출물과 동일 구조)
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  profile              Profile?
  ownedProjects        Project[]             @relation("ProjectOwner")
  memberships          ProjectMember[]
  likes                ProjectLike[]
  follows              ProjectFollow[]
  tries                ProjectTry[]
  createdEvents        ProjectEvent[]        @relation("EventAuthor")
  surveyParticipations SurveyParticipation[]
  raffleEntries        RaffleEntry[]
  reportsFiled         Report[]              @relation("Reporter")
  reportsResolved      Report[]              @relation("ReportResolver")
  notifications        Notification[]
  mattermostIdentity   MattermostIdentity?
  bugReports           BugReport[]
  projectUpdates       ProjectUpdate[]
  deliveries           MattermostDelivery[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Better Auth 는 (providerId, accountId) 에 unique 를 기대하지 않는다.
  // 제약으로 걸면 재연결 같은 경로에서 라이브러리가 처리하는 대신 DB 에러로 터진다.
  @@index([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// 프로필
// ─────────────────────────────────────────────────────────────

enum UserRole {
  MEMBER
  ADMIN
}

model Profile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 기수_지역_반_이름 형식으로만 저장된다(src/features/profile/nickname.ts).
  displayName String
  bio         String?
  role        UserRole @default(MEMBER)

  // 기수는 닉네임(displayName) 첫 칸에서 그대로 따온다 — 따로 입력받지 않는다.
  // 둘을 각각 받으면 어긋난 상태가 생기고, 어느 쪽이 맞는지 알 방법이 없다.
  // 트랙은 여전히 선택 입력이다.
  ssafyGeneration Int?
  ssafyTrack      String?

  // GitHub 계정을 연결한 사람만 프로젝트를 올릴 수 있다. 연결 시 여기에 로그인명이 채워지고,
  // 저장소 소유권 검증에 그대로 쓰인다.
  githubLogin String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([githubLogin])
  @@map("profile")
}

// ─────────────────────────────────────────────────────────────
// 프로젝트
// ─────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT // 작성 중, 본인만 봄
  PUBLISHED // 공개
  HIDDEN // 관리자가 내림 (되돌릴 수 있음)
  REMOVED // 관리자가 삭제
}

enum ProjectCategory {
  WEB
  MOBILE
  AI
  GAME
  TOOL
  EMBEDDED
  DATA
  ETC
}

model Project {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  tagline     String
  description String // 마크다운. 렌더 시 새니타이즈 필수
  category    ProjectCategory
  tags        String[]        @default([])

  // 실제로 써볼 수 있는 주소가 이 서비스의 핵심이다. "둘러본다 → 써본다 → 피드백" 에서
  // 써볼 곳이 없으면 나머지가 성립하지 않으므로 데모는 필수로 둔다.
  demoUrl     String
  // 저장소는 선택이다. 넣으면 스타·언어·README 를 가져오고 소유권 확인 배지가 붙는다.
  // https://github.com/{owner}/{repo} 형태만 허용한다.
  repoUrl     String?
  iconUrl     String?
  screenshots String[] @default([])

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // 업로더의 GitHub 계정이 저장소 owner/collaborator 인지 확인된 경우 true.
  // 조직 저장소 등은 미확인이어도 등록은 되게 하고 배지로만 구분한다.
  // repoUrl 이 없으면 확인할 대상 자체가 없으므로 항상 false 다.
  ownershipVerified Boolean @default(false)

  status      ProjectStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members    ProjectMember[]
  snapshot   GithubRepoSnapshot?
  likes      ProjectLike[]
  follows    ProjectFollow[]
  tries      ProjectTry[]
  stats      ProjectStatDaily[]
  events     ProjectEvent[]
  surveys    Survey[]
  raffles    Raffle[]
  featured   FeaturedSlot[]
  updates    ProjectUpdate[]
  bugs       BugReport[]
  deliveries MattermostDelivery[]

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([ownerId])
}

enum ProjectMemberRole {
  OWNER
  MAINTAINER
  CONTRIBUTOR
}

model ProjectMember {
  id                    String            @id @default(uuid())
  projectId             String
  project               Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                  ProjectMemberRole @default(CONTRIBUTOR)
  notifyManagement      Boolean           @default(false)
  notificationChangedAt DateTime          @default(now())
  createdAt             DateTime          @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_member")
}

/// GitHub REST API 응답 캐시. 페이지 요청마다 GitHub 를 때리지 않기 위해 존재한다.
/// fetchedAt 기준 TTL 6시간으로 갱신하고, pushedAt 은 홈의 "최근 업데이트" 정렬 기준으로도 쓴다.
model GithubRepoSnapshot {
  projectId String  @id
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  owner           String
  repo            String
  description     String?
  stars           Int       @default(0)
  forks           Int       @default(0)
  openIssues      Int       @default(0)
  primaryLanguage String?
  languages       Json      @default("{}")
  license         String?
  topics          String[]  @default([])
  archived        Boolean   @default(false)
  pushedAt        DateTime?

  /// GitHub 가 렌더해준 README HTML. 남의 저장소에서 온 신뢰 불가 콘텐츠이므로
  /// 저장 시점이 아니라 렌더 시점에 rehype-sanitize 를 반드시 통과시킨다.
  readmeHtml String?

  fetchedAt DateTime @default(now())

  @@index([pushedAt])
  @@map("github_repo_snapshot")
}

// ─────────────────────────────────────────────────────────────
// 반응 지표
// ─────────────────────────────────────────────────────────────

model ProjectLike {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@index([createdAt])
  @@map("project_like")
}

/// 관심 등록. 이 프로젝트의 일정이 내 캘린더에 뜨는 기준이 된다.
model ProjectFollow {
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  notifyUpdates         Boolean  @default(false)
  notifyRecruitment     Boolean  @default(false)
  notificationChangedAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@index([createdAt])
  @@map("project_follow")
}

/// "써봤어요". 설문 응답 자격과는 무관하지만 인기 점수에서 가중치가 높다.
model ProjectTry {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@index([createdAt])
  @@map("project_try")
}

/// 일별 롤업. 배치 없이 발생 시점에 증분한다.
///
/// **되돌릴 수 없는 지표만 담는다.** 좋아요·관심등록·써봤어요를 여기에 누적하면
/// 껐다 켜기를 반복해 점수를 무한히 부풀릴 수 있다. 그 셋은 피벗 테이블에
/// 정확한 현재 상태가 있으므로 createdAt 으로 직접 센다.
///
/// 설문 응답 수는 여기 있다. 응답은 취소할 수 없어 부풀릴 수 없고, 무엇보다
/// SurveyResponse 에는 시간 정보를 두지 않기로 했기 때문에 기간별 집계를 낼
/// 곳이 여기뿐이다. 이 카운터는 개인과 연결되지 않는 합계라서 익명성을 해치지 않는다.
model ProjectStatDaily {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date

  views           Int @default(0)
  outboundClicks  Int @default(0)
  surveyResponses Int @default(0)

  @@id([projectId, day])
  @@index([day])
  @@map("project_stat_daily")
}

/// 운영자가 직접 고르는 큐레이션 자리. 홈 최상단 "에디터 추천"에 노출된다.
model FeaturedSlot {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  headline  String?
  startsAt  DateTime
  endsAt    DateTime
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([startsAt, endsAt])
  @@map("featured_slot")
}

// ─────────────────────────────────────────────────────────────
// 일정 (사이트 내부 캘린더 전용 — 외부 캘린더 구독 피드는 만들지 않는다)
// ─────────────────────────────────────────────────────────────

enum ProjectEventType {
  TEST // 베타 테스트 모집·진행
  UPDATE // 업데이트 배포
  SURVEY // 설문 진행 (설문 개설 시 자동 생성)
  RELEASE // 정식 출시
  RAFFLE // 추첨 마감·발표 (추첨 개설 시 자동 생성)
  MILESTONE
  OTHER
}

model ProjectEvent {
  id          String           @id @default(uuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        ProjectEventType
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean          @default(false)
  url         String?

  createdById String?
  createdBy   User?   @relation("EventAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// 설문·추첨에서 자동 생성된 일정은 원본 식별자를 남겨 중복 생성과 고아 일정을 막는다.
  autoSourceType String?
  autoSourceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([autoSourceType, autoSourceId])
  @@index([startsAt])
  @@index([projectId, startsAt])
  @@map("project_event")
}

// ─────────────────────────────────────────────────────────────
// 설문 — 익명성 보장 구조
// ─────────────────────────────────────────────────────────────

model Survey {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// [{ id, type: 'rating'|'choice'|'text', label, required, options?, max? }]
  questions   Json
  isOpen      Boolean   @default(true)
  opensAt     DateTime  @default(now())
  closesAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  responses      SurveyResponse[]
  participations SurveyParticipation[]
  raffles        Raffle[]

  @@index([projectId])
  @@index([isOpen])
}

/// 설문 응답 내용.
///
/// **이 모델에는 userId 가 없고, 앞으로도 추가하면 안 된다.** 제작자에게 작성자 정보를 주지
/// 않는다는 약속의 근거가 스키마 그 자체이기 때문이다.
///
/// 다만 이것이 "누구도 알아낼 수 없다" 는 뜻은 아니다. 응답자가 한 명뿐이면 이 표와
/// survey_participation 을 나란히 놓기만 해도 대응이 보인다. 표본이 작을 때 익명성을 깨는 것은
/// 구조가 아니라 표본 크기다. 그래서 화면 쪽에도 조치를 둔다 —
/// 개별 응답은 3건 단위 묶음으로만 공개한다(아래 revealed 참고).
///
/// 재식별 경로를 막기 위한 두 가지 추가 조치:
///  - id 는 순번이 아니라 UUID 다. 제출 순서를 추론할 수 없다.
///  - **시간 정보를 아예 담지 않는다.** 처음에는 날짜만 남겼는데, 하루 응답이 한 건뿐인
///    날이면 그 날짜만으로 SurveyParticipation.createdAt 과 1:1 로 붙어버린다.
///    소규모 사용자층에서는 그런 날이 흔하다. 그래서 날짜조차 두지 않는다.
///    기간별 집계가 필요한 곳(홈의 주간 인기)은 개인과 무관한
///    ProjectStatDaily.surveyResponses 카운터를 쓴다.
model SurveyResponse {
  id       String @id @default(uuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  /// { [questionId]: number | string | string[] }
  answers Json

  /// 개별 응답을 제작자에게 보여줘도 되는지. **한 번 켜지면 다시 꺼지지 않는다.**
  ///
  /// "3건 이상이면 공개" 만으로는 부족했다. 제작자가 결과 화면을 열어둔 채 기다리다
  /// 3건에서 4건이 되는 순간, 늘어난 하나가 무엇인지 보인다. 그러면 그 응답은 방금
  /// 부탁했던 사람의 것으로 좁혀진다.
  ///
  /// 그래서 3의 배수에 닿을 때마다 그때까지 감춰둔 것을 한꺼번에 켠다.
  /// 4·5번째 응답이 들어와도 화면은 그대로 3건이고, 6건이 되는 순간 셋이 함께 나타난다.
  /// 어느 것이 새 것인지 가려진다.
  ///
  /// 이 컬럼이 남기는 것: 덤프를 보면 아직 안 켜진 두 건 이하가 가장 최근이라는 사실.
  /// 그건 제작자가 화면에서 이미 아는 것과 같은 크기이고, 순번이나 시각과 달리
  /// 전체를 줄 세우지는 못한다. 순서를 더 세밀하게 담는 필드는 앞으로도 넣지 않는다.
  revealed Boolean @default(false)

  @@index([surveyId])
  @@index([surveyId, revealed])
  @@map("survey_response")
}

/// "이 사람이 이 설문에 응답했다"는 사실만 남긴다. 응답 내용은 여기에 없다.
/// 중복 응답 차단과 추첨 응모 자격 판정에만 쓰인다.
model SurveyParticipation {
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([surveyId, userId])
  @@index([userId])
  @@map("survey_participation")
}

// ─────────────────────────────────────────────────────────────
// 추첨 — commit–reveal 로 사후 검증 가능하게
// ─────────────────────────────────────────────────────────────

enum RaffleStatus {
  OPEN
  CLOSED // 마감됐지만 아직 추첨 전
  DRAWN
  CANCELLED
}

model Raffle {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  surveyId  String
  survey    Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  prizeName        String
  prizeDescription String?
  winnerCount      Int     @default(1)

  opensAt  DateTime @default(now())
  closesAt DateTime

  /// 개설 시점에 공개하는 커밋값 = sha256(seed).
  seedHash String
  /// 추첨 전까지 비공개. 추첨 후 공개되어 누구나 당첨자를 재계산할 수 있다.
  seed     String?

  status  RaffleStatus @default(OPEN)
  drawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries RaffleEntry[]
  winners RaffleWinner[]

  @@index([projectId])
  @@index([status, closesAt])
}

model RaffleEntry {
  id       String @id @default(uuid())
  raffleId String
  raffle   Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 추첨 계산과 공개 검증의 단위. 사용자 식별자 대신 이 값이 공개된다.
  ticketCode String @unique

  createdAt DateTime @default(now())

  winner RaffleWinner?

  @@unique([raffleId, userId])
  @@index([raffleId])
  @@map("raffle_entry")
}

enum ClaimStatus {
  PENDING // 당첨자가 아직 연락처를 안 냄
  SUBMITTED // 연락처 제출됨
  DELIVERED // 경품 지급 완료
  FORFEITED // 기한 내 미수령
}

model RaffleWinner {
  id       String      @id @default(uuid())
  raffleId String
  raffle   Raffle      @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  entryId  String      @unique
  entry    RaffleEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  rank     Int

  /// 당첨자가 직접 제출한다. 제작자만 열람할 수 있다.
  contactInfo String?
  claimStatus ClaimStatus @default(PENDING)

  announcedAt DateTime @default(now())

  @@index([raffleId])
  @@map("raffle_winner")
}

// ─────────────────────────────────────────────────────────────
// 신고
//
// 자동 숨김은 의도적으로 없다. 신고 N건으로 프로젝트가 내려간다면 경쟁 프로젝트를
// 신고 몇 번으로 죽일 수 있고, 오신고 한 번에 멀쩡한 프로젝트가 사라진다.
// 신고는 관리자 큐에 쌓이고, severity 는 알림 세기와 정렬 순서만 결정한다.
// 숨김·삭제는 언제나 관리자의 수동 판단이다.
// ─────────────────────────────────────────────────────────────

enum ReportTargetType {
  PROJECT
  PROJECT_EVENT
  SURVEY_RESPONSE
  USER
}

enum ReportReason {
  MALWARE // 악성코드·바이러스·피싱
  DATA_HARVESTING // 과도한 개인정보 수집·자격증명 요구
  IMPERSONATION // 타인·기업 사칭
  COMMERCIAL_SALE // 외부 상업 판매·결제 유도·광고
  COPYRIGHT // 코드·에셋 도용, 라이선스 위반
  INAPPROPRIATE // 음란·폭력·혐오
  RAFFLE_FRAUD // 추첨 조작·경품 미지급
  SPAM // 도배·중복 등록
  BROKEN_LINK // 링크 깨짐·동작 불가 (제보성)
  OTHER
}

enum ReportSeverity {
  CRITICAL // 관리자 즉시 알림 + 큐 최상단
  HIGH // 큐 상단, 일일 요약
  NORMAL // 일반 큐
  INFO // 관리자 큐를 거치지 않고 제작자에게만 전달
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTION_TAKEN // 관리자가 숨김/삭제 조치함
  REJECTED // 반려
}

model Report {
  id         String           @id @default(uuid())
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  severity   ReportSeverity
  detail     String?

  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  status         ReportStatus @default(OPEN)
  resolvedById   String?
  resolvedBy     User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())

  /// 같은 사람이 같은 대상을 반복 신고해 큐를 부풀리는 것을 막는다.
  @@unique([targetType, targetId, reporterId])
  @@index([status, severity, createdAt])
  @@index([targetType, targetId])
  @@map("report")
}

// ─────────────────────────────────────────────────────────────
// 알림 (사이트 내부 전용)
//
// 무엇을 알리지 "않는가" 가 이 기능의 핵심이다.
// 설문에 새 응답이 들어올 때마다 제작자에게 알리면, 제작자는 응답이 도착한
// 시각을 알게 된다. 응답 행에서 시간을 지워둔 의미가 그 알림으로 되살아난다.
// "방금 A한테 써달라고 부탁했는데 5분 뒤 알림이 왔다" 는 추론이 가능해진다.
// 그래서 개별 응답 알림은 만들지 않고, 임계(3건)에 도달했을 때 한 번만 알린다.
// ─────────────────────────────────────────────────────────────

enum NotificationType {
  BUG_REPORTED
  BUG_STATUS_CHANGED
  RAFFLE_WON // 당첨자에게
  RAFFLE_READY_TO_DRAW // 제작자에게, 응모 마감
  RAFFLE_CONTACT_SUBMITTED // 제작자에게, 당첨자가 연락처를 냄
  SURVEY_THRESHOLD_REACHED // 제작자에게, 개별 응답을 볼 수 있게 됨
  REPORT_FILED // 관리자에게
  REPORT_RESOLVED // 제작자에게, 조치 결과
  BROKEN_LINK_REPORTED // 제작자에게
  ADMIN_GRANTED // 관리자로 임명됨
}

// Identity is verified server-side against the fixed SSAFY Mattermost host.
// No user OAuth tokens or personal webhooks are retained.
model MattermostIdentity {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mattermostUserId String   @unique
  username         String
  verifiedAt       DateTime @default(now())
}

enum ProjectUpdateKind {
  UPDATE
  RECRUITMENT
}

model ProjectUpdate {
  id        String            @id @default(uuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind      ProjectUpdateKind @default(UPDATE)
  title     String
  body      String
  createdAt DateTime          @default(now())

  @@index([projectId, createdAt])
}

enum BugStatus {
  OPEN
  INVESTIGATING
  FIXED
}

model BugReport {
  id                    String    @id @default(uuid())
  projectId             String
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporterId            String
  reporter              User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  title                 String
  description           String
  status                BugStatus @default(OPEN)
  resolution            String    @default("")
  notifyStatus          Boolean   @default(false)
  notificationChangedAt DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([projectId, createdAt])
  @@index([reporterId, createdAt])
}

enum DeliveryKind {
  UPDATE
  RECRUITMENT
  MANAGEMENT
  BUG_STATUS
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  CANCELLED
  FAILED
}

// Transactional outbox: create alongside the event, recheck consent before sending.
model MattermostDelivery {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        DeliveryKind
  sourceId    String
  dedupeKey   String         @unique
  status      DeliveryStatus @default(PENDING)
  attempts    Int            @default(0)
  availableAt DateTime       @default(now())
  leaseUntil  DateTime?
  leaseToken  String?
  lastError   String?
  createdAt   DateTime       @default(now())
  sentAt      DateTime?

  @@index([status, availableAt])
}

model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  title String
  body  String?
  url   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification")
}
