# ── 데이터베이스 ────────────────────────────────────────────────
# 로컬: docker compose up -d 로 띄운 PostgreSQL 18
# 운영: Neon 등의 서버리스 Postgres 연결 문자열 (?sslmode=require 를 붙인다)
DATABASE_URL="postgresql://firework:firework@localhost:5432/firework?schema=public"

# 마이그레이션 전용 직결 주소. 운영에서만 필요하다.
# DATABASE_URL 이 풀러(호스트에 -pooler 가 붙은 주소)를 거치면 런타임은 그걸 써도
# 되지만 마이그레이션은 안 된다 — PgBouncer 뒤에서는 DDL 과 어드바이저리 락이
# 어긋난다. 그래서 CLI 는 이 값이 있으면 이쪽을 쓴다. 로컬에서는 비워두면 된다.
DIRECT_DATABASE_URL=""

# ── Better Auth ────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── 소셜 로그인 ────────────────────────────────────────────────
# 콜백 URL 은 모두 {BETTER_AUTH_URL}/api/auth/callback/{provider} 형태다.
# 하나도 설정하지 않으면 로그인 화면에 아무 버튼도 뜨지 않는다. 최소 하나는 채울 것.

# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# https://developers.kakao.com/console/app
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# https://developers.naver.com/apps
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# https://github.com/settings/developers
# 프로젝트 업로더는 이 계정 연결이 필수이므로 GitHub 은 사실상 항상 필요하다.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── 이메일 인증 ────────────────────────────────────────────────
# 이메일 확인은 선택이다. 설문·추첨·프로젝트 등록을 막는 것은 닉네임뿐이다.
# 다만 관리자 승격(ADMIN_EMAILS)은 확인된 이메일에만 적용되므로 그쪽에는 필요하다.
#
# 비워두면 인증 코드가 서버 콘솔(터미널)에 찍힌다 — 키 없이도 흐름을 확인할 수 있다.
# 실제 발송: https://resend.com/api-keys (무료 3,000통/월)
RESEND_API_KEY=""
# 도메인을 붙이기 전에는 비워두면 Resend 테스트 발신 주소를 쓴다.
EMAIL_FROM=""

# ── 최초 관리자 ────────────────────────────────────────────────
# 콤마로 구분한 이메일 목록. 여기 적힌 이메일로 로그인하면 관리자로 승격된다.
# 배포 직후에는 관리자가 아무도 없어 신고 큐를 열 사람이 없으므로 최소 하나는 채울 것.
# 승격은 이메일이 검증된 계정에만 적용되므로 Google 또는 GitHub 로 로그인해야 한다.
# 첫 관리자가 생긴 뒤로는 /admin/users 에서 다른 사람을 임명할 수 있다.
ADMIN_EMAILS="corqjffp010@gmail.com"

# ── GitHub REST API ────────────────────────────────────────────
# 저장소 메타(스타·언어·README) 수집용 read-only PAT.
# 없으면 시간당 60회로 제한돼 금방 막힌다. 있으면 5,000회.
# public repo 읽기 권한만 있으면 된다.
GITHUB_TOKEN=""
