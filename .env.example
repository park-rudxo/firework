# ── 데이터베이스 ────────────────────────────────────────────────
# 로컬: docker compose up -d 로 띄운 PostgreSQL 18
# 운영: Neon 등의 서버리스 Postgres 연결 문자열
DATABASE_URL="postgresql://firework:firework@localhost:5432/firework?schema=public"

# ── Better Auth ────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── 소셜 로그인 ────────────────────────────────────────────────
# 콜백 URL 은 모두 {BETTER_AUTH_URL}/api/auth/callback/{provider} 형태다.
# 하나도 설정하지 않으면 로그인 화면에 아무 버튼도 뜨지 않는다. 최소 하나는 채울 것.
# 값을 넣은 뒤에는 개발 서버를 다시 시작해야 반영된다.
#
# 아래 절차를 그대로 출력해주는 명령이 있다: npm run doctor

# https://developers.kakao.com/console/app
# 1) 애플리케이션 추가 → 앱 설정 → 플랫폼 → Web 에 http://localhost:3000
# 2) 카카오 로그인 활성화 ON, Redirect URI 에 콜백 등록
# 3) 동의항목에서 닉네임·프로필 사진·카카오계정(이메일) 켜기
#    (이메일은 개인 개발자 앱에서 잠겨 있을 수 있다. 이메일이 안 오면 가입이 실패한다.)
# 4) ID 는 앱 키의 "REST API 키", SECRET 은 카카오 로그인 → 보안에서 생성 후 '사용함' 으로
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# https://developers.naver.com/apps/#/register
# 1) 사용 API 에서 "네이버 로그인" 선택, 제공 정보에 회원이름·이메일 주소 체크
# 2) 로그인 오픈 API 서비스 환경 → PC 웹 → 서비스 URL 과 Callback URL 등록
# 3) 검수 전에는 개발자 본인과 콘솔 멤버로 등록한 계정만 로그인된다.
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# https://console.cloud.google.com/apis/credentials
# 1) OAuth 동의 화면을 먼저 구성한다 (User Type 외부)
# 2) 사용자 인증 정보 만들기 → OAuth 클라이언트 ID → 웹 애플리케이션
# 3) 승인된 리디렉션 URI 에 콜백 등록
# 4) 게시 상태가 "테스트" 면 테스트 사용자에 넣은 계정만 로그인된다.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# https://github.com/settings/developers → New OAuth App
# Authorization callback URL 에 콜백을 넣는다.
# 프로젝트 업로더는 이 계정 연결이 필수이므로 GitHub 은 사실상 항상 필요하다.
# 아래 GITHUB_TOKEN 과는 다른 값이다.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── 이메일 인증 ────────────────────────────────────────────────
# 소셜 로그인 뒤 이메일을 한 번 확인한다. 단, 프로바이더가 이미 검증해준 경우
# (Google·GitHub·Kakao)는 그대로 통과하고, 검증 정보를 주지 않는 네이버 등만 거친다.
#
# 비워두면 인증 코드가 서버 콘솔(터미널)에 찍힌다 — 키 없이도 흐름을 확인할 수 있다.
# 실제 발송: https://resend.com/api-keys (무료 3,000통/월)
RESEND_API_KEY=""
# 도메인을 붙이기 전에는 비워두면 Resend 테스트 발신 주소를 쓴다.
EMAIL_FROM=""

# ── 문의처 ─────────────────────────────────────────────────────
# 이용약관과 개인정보처리방침 화면에 노출된다. 비워두면 저장소 이슈 링크를 대신 보여준다.
# 카카오 비즈 앱 전환·네이버 로그인 검수에서 문의 창구를 확인하므로 배포 전에는 채울 것.
CONTACT_EMAIL=""

# ── 최초 관리자 ────────────────────────────────────────────────
# 콤마로 구분한 이메일 목록. 여기 적힌 이메일로 로그인하면 관리자로 승격된다.
# 배포 직후에는 관리자가 아무도 없어 신고 큐를 열 사람이 없으므로 최소 하나는 채울 것.
# 승격은 이메일이 검증된 계정에만 적용되므로 Google 또는 GitHub 로 로그인해야 한다.
# 첫 관리자가 생긴 뒤로는 /admin/users 에서 다른 사람을 임명할 수 있다.
ADMIN_EMAILS="corqjffp010@gmail.com"

# ── GitHub REST API ────────────────────────────────────────────
# 저장소 메타(스타·언어·README) 수집용 read-only PAT.
# 없으면 시간당 60회로 제한돼 금방 막힌다. 있으면 5,000회.
# public repo 읽기 권한만 있으면 된다.
GITHUB_TOKEN=""
